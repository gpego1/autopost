SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<supabase-service-role-secret-key>
SUPABASE_JWT_SECRET=<supabase-jwt-secret-from-project-settings>
DATABASE_URL=postgresql+asyncpg://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres
ENCRYPT_KEY=<base64-encoded-32-byte-fernet-key>
CRON_SECRET=<random-secret-set-in-vercel-env-and-cron-header>
META_APP_ID=<meta-facebook-app-id>
META_APP_SECRET=<meta-facebook-app-secret>
LINKEDIN_CLIENT_ID=<linkedin-oauth-client-id>
LINKEDIN_CLIENT_SECRET=<linkedin-oauth-client-secret>
FRONTEND_URL=https://<your-project>.vercel.app
SENTRY_DSN=<sentry-dsn-url-or-leave-empty>
ENVIRONMENT=development
